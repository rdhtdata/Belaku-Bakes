      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEv15E089n-KS1IGe5V8FFU9Gil-N-_E_TbBcy415cPdwjLfaBkexuRN3pNrGnTDWFu7zC272zAqaAI2twqET0phfwZvQ2Lxz1xOcyroOP6BGtV3VkZ0omAfae95oEW_Nku_aRZq3IRZAy4gKea3Ew02hTF9x-dPBzXY0-vSNPqr_YQAhDhiDWhJwd0rmVKKBlXPpJWP3vOwOTycfaerCx7opcJGL0rEoofPgERzxL4MFGmZXKKLjcg-e0TXbYgUgU9GPDbN6DTNLE="
