    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { MapPin, Copy, Check, ExternalLink, RefreshCw, Smartphone, Package, Info, Clock } from \"lucide-react\";\nimport { CONTACT_INFO } from \"../data\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\nexport default function PickupGuide() {\n  const [copied, setCopied] = useState(false);\n  const [selectedTransport, setSelectedTransport] = useState(\"genie\");\n\n  const handleCopyAddress = () => {\n    navigator.clipboard.writeText(CONTACT_INFO.address);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const transportGuides = [\n    {\n      id: \"genie\",\n      name: \"Swiggy Genie\",\n      color: \"border-orange-500 text-orange-600 bg-orange-50/40\",\n      steps: [\n        \"Open your Swiggy App and select the \'Genie\' tab.\",\n        \"Set Pickup Location to: \'Belaku Bakes, Hennur, Bangalore\' (Paste copied address).\",\n        \"Set Dropoff Location to your current desired delivery address.\",\n        \"Under Task Description, write: \'Handhold fresh pastry box. Keep flat and carry carefully inside a bag.\'\",\n        \"Specify package content as \'Bakery Items (Fragile)\' and select Two-Wheeler transport.\"\n      ],\n      tip: \"Recommended for cupcakes, cookies, brownies, small cakes (up to 1 Kg).\"\n    },\n    {\n      id: \"dunzo\",\n      name: \"Dunzo\",\n      color: \"border-emerald-600 text-emerald-700 bg-emerald-50/40\",\n      steps: [\n        \"Open your Dunzo App and double-tap \'Dunzo Delivery\'.\",\n        \"Paste Belaku Bakes\' copied Hennur coordinate address as the Pickup Location.\",\n        \"Set your home or party venue coordinate as the Destination address.\",\n        \"Add a critical courier pickup instruction: \'Pastry Cake: fragile, flat-bottom. Hand-carry if possible, do not double stack.\'\",\n        \"Book Dunzo runner!\"\n      ],\n      tip: \"Dunzo runners are highly accustomed to dessert pickups and handle bags nicely.\"\n    },\n    {\n      id: \"porter\",\n      name: \"Porter (Car / 3-Wheeler)\",\n      color: \"border-blue-500 text-blue-600 bg-blue-50/40\",\n      steps: [\n        \"Open the Porter App and select \'Porter for Package\'.\",\n        \"Ideal option if you ordered large customized cakes (1.5 Kg or higher) to avoid road cracks.\",\n        \"Input Hennur Pick location & and enter contact: 9663307314 (Vaishnavi K.S.).\",\n        \"Choose \'3-Wheeler\' or \'Porter Car\' which keeps cake standing perfectly flat on the bottom seat with AC turned on.\"\n      ],\n      tip: \"Highly recommended for massive celebration tiered-cakes or dense savouries batches!\"\n    }\n  ];\n\n  const currentGuide = transportGuides.find(t => t.id === selectedTransport) || transportGuides[0];\n\n  return (\n    <section id=\"pickup\" className=\"py-24 bg-brand-cream relative\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        \n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-16 items-center\">\n          \n          {/* Left Area: Address details & self pickup explanation */}\n          <div className=\"lg:col-span-6 text-left space-y-8\">\n            <div className=\"space-y-3\">\n              <span className=\"inline-flex items-center space-x-2 text-xs uppercase tracking-widest text-brand-caramel font-bold\">\n                <MapPin className=\"w-3.5 h-3.5 text-brand-caramel\" />\n                <span>Logistics &amp; Transport</span>\n              </span>\n              <h2 className=\"font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-espresso tracking-tight leading-tight\">\n                Self-Pickup Guide <br />\n                <span className=\"text-brand-caramel italic font-normal\">from our Hennur kitchen</span>\n              </h2>\n            </div>\n\n            <p className=\"font-sans text-brand-espresso/80 text-sm sm:text-base font-light leading-relaxed\">\n              We operate exclusively as a boutique cloud kitchen to prioritize peak oven cleanliness, fresh organic ingredient batches, and pure handcrafting hours. Consequently, <strong className=\"font-semibold text-brand-espresso\">we do not employ an in-house delivery fleet</strong>.\n            </p>\n\n            <div className=\"bg-brand-linen rounded-2xl p-6 border border-brand-stone/60 space-y-4\">\n              <span className=\"block text-xs uppercase tracking-wider font-bold text-brand-espresso\">\n                Belaku Bakes Gate Address\n              </span>\n              \n              <p className=\"text-xs text-brand-espresso/90 font-mono leading-relaxed bg-brand-cream/60 p-3 rounded-lg border border-brand-stone/40\">\n                {CONTACT_INFO.address}\n              </p>\n\n              <div className=\"flex flex-col sm:flex-row gap-3 pt-1\">\n                <button\n                  onClick={handleCopyAddress}\n                  className=\"inline-flex items-center justify-center space-x-2 py-3 px-5 bg-brand-espresso text-brand-cream hover:bg-brand-caramel hover:text-brand-espresso rounded-xl text-xs uppercase font-bold tracking-wider transition-colors cursor-pointer\"\n                >\n                  {copied ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-brand-gold\" />\n                      <span>Copied Address!</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Copy Address</span>\n                    </>\n                  )}\n                </button>\n\n                <a\n                  href={CONTACT_INFO.mapCoordinateGoogleMaps}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center justify-center space-x-2 py-3 px-5 bg-transparent border border-brand-stone text-brand-espresso hover:bg-brand-linen rounded-xl text-xs uppercase font-bold tracking-wider transition-colors\"\n                >\n                  <span>Google Maps Coordinates</span>\n                  <ExternalLink className=\"w-3.5 h-3.5\" />\n                </a>\n              </div>\n            </div>\n\n            {/* Quick operating hours indicator */}\n            <div className=\"flex items-center space-x-4 text-xs font-sans text-brand-espresso/80\">\n              <div className=\"flex items-center space-x-1.5 bg-brand-linen/40 px-3 py-1.5 rounded-full border border-brand-stone/20\">\n                <Clock className=\"w-3.5 h-3.5 text-brand-caramel\" />\n                <span>Tue-Sun: {CONTACT_INFO.operatingHours.split(\" (\")[0]}</span>\n              </div>\n              <div className=\"text-brand-caramel font-semibold bg-brand-espresso text-brand-cream px-3 py-1.5 rounded-full border border-transparent\">\n                Closed Mondays\n              </div>\n            </div>\n\n          </div>\n\n          {/* Right Area: Interactive Transport Planner */}\n          <div className=\"lg:col-span-6 bg-brand-linen rounded-3xl p-6 sm:p-10 shadow-lg border border-brand-stone/60\">\n            <div className=\"text-left space-y-4\">\n              <div className=\"flex items-center space-x-2 text-brand-caramel\">\n                <Package className=\"w-5 h-5\" />\n                <span className=\"font-serif text-lg font-semibold text-brand-espresso\">App Transport Planner</span>\n              </div>\n              <p className=\"text-xs text-brand-espresso/70 font-light\">\n                Click your preferred local courier app to see precise guidelines on booking the courier runner securely. Set pickup to Hennur, Bangalore!\n              </p>\n            </div>\n\n            {/* App selectors */}\n            <div className=\"grid grid-cols-3 gap-2 mt-6\">\n              {[\n                { id: \"genie\", label: \"Swiggy Genie\" },\n                { id: \"dunzo\", label: \"Dunzo Pick\" },\n                { id: \"porter\", label: \"Porter Car/Cab\" }\n              ].map((tn) => (\n                <button\n                  key={tn.id}\n                  onClick={() => setSelectedTransport(tn.id)}\n                  className={`py-2 px-1 text-[11px] font-sans font-bold uppercase rounded-xl border block tracking-wide cursor-pointer transition-all ${\n                    selectedTransport === tn.id\n                      ? \"bg-brand-espresso text-brand-cream border-brand-espresso shadow\"\n                      : \"bg-brand-cream text-brand-espresso/60 border-brand-stone hover:bg-brand-linen\"\n                  }`}\n                >\n                  {tn.label}\n                </button>\n              ))}\n            </div>\n\n            {/* Steps Container */}\n            <div className=\"mt-6 bg-brand-cream rounded-2xl p-6 border border-brand-stone text-left\">\n              <AnimatePresence mode=\"wait\">\n                <motion.div\n                  key={selectedTransport}\n                  initial={{ opacity: 0, x: 8 }}\n                  animate={{ opacity: 1, x: 0 }}\n                  exit={{ opacity: 0, x: -8 }}\n                  className=\"space-y-4\"\n                >\n                  <div className={`p-2.5 rounded-lg border text-xs font-semibold tracking-wide ${currentGuide.color}`}>\n                    {currentGuide.name} Guide Lines\n                  </div>\n\n                  <ul className=\"space-y-3 font-sans text-xs text-brand-espresso/80 leading-relaxed font-light\">\n                    {currentGuide.steps.map((st, idx) => (\n                      <li key={idx} className=\"flex space-x-2\">\n                        <span className=\"font-semibold text-brand-caramel\">{idx + 1}.</span>\n                        <span>{st}</span>\n                      </li>\n                    ))}\n                  </ul>\n\n                  <div className=\"mt-4 p-3 bg-brand-linen rounded-xl border border-dashed border-brand-stone flex items-start space-x-2 text-xs\">\n                    <Info className=\"w-4 h-4 text-brand-caramel shrink-0 mt-0.5\" />\n                    <p className=\"text-brand-espresso/80 font-light italic\">\n                      <strong>Pro Tip:</strong> {currentGuide.tip}\n                    </p>\n                  </div>\n                </motion.div>\n              </AnimatePresence>\n            </div>\n\n            {/* Real Map coordinate mock visual */}\n            <div className=\"mt-6 relative h-[140px] rounded-2xl overflow-hidden border border-brand-stone bg-brand-stone\">\n              <iframe\n                title=\"Hennur Lake Map coordinate mockup\"\n                className=\"w-full h-full grayscale-30 border-0\"\n                src=\"https://maps.google.com/maps?q=Hennur%20Lake,%20Hennur%20Road,%20Bangalore&t=&z=14&ie=UTF8&iwloc=&output=embed\"\n                allowFullScreen\n              />\n              <div className=\"absolute top-2 right-2 bg-brand-espresso/90 text-brand-cream text-[9px] font-bold uppercase p-1.5 rounded-md backdrop-blur-xs select-none\">\n                Hennur, Bengaluru\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n}\n"
    }
