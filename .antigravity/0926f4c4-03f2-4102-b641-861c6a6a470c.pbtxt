    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQG0dgdtTg6owSMuhgwDSPEXsDmLeyWVv5kiku0nKlWr1Wwri9Q12_j0vA7mL9l2V-3K_bPODCyGeAAJ_g3JxF42FKj5khB6KJF9dc6lG6SU3hrWl86pojxHUEN_SLHcHYK89_3KnpIfDy_prVEZ7WVwNUXxPn4_zg=="
