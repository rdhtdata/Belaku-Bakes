    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGpcCrdZ4StqxBKgRGdBos80Wcn_U3xmVBn2RUiAv47rcKixgxU5uka0QjphdJXa_exkRg3Ewc3str0nKPo8mtHylJEfYlcFKYp_KPnpbhwfq5hfWZGu1Vil4TXNDkoG5-_XYgvp8wFT3nzVCazPx7SSMedMWpfbepFpkRXZa_t2vlsCqwgfjeUzOd8-HKmI-qx-jWoJ1dYzOLnM2bakhyBd1axFl11gg=="
