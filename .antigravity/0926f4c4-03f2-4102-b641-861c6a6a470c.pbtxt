    replacement_chunks {
      replacement_content: "import { MenuItem, Testimonial } from \"./types\";\n\nexport const MENU_ITEMS: MenuItem[] = [\n  // CUSTOMIZED CAKES\n  {\n    id: \"cake-1\",\n    name: \"Rose Petal & Vanilla Bean Blossom\",\n    description: \"An elegant, airy sponge cake layered with premium Madagascar vanilla bean buttercream and infused with a delicate organic rose-water liqueur. Adorned with edible real rose petals.\",\n    priceEstimate: \"\342\202\2711,400 / Kg\",\n    category: \"cakes\",\n    image: \"https://images.unsplash.com/photo-1535141192574-5d4897c13636?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.9,\n    tags: [\"Signature\", \"Custom-crafted\", \"Best Seller\"],\n    customizable: true,\n    flavors: [\"Madagascar Vanilla & Rose\", \"Rich Chocolate Truffle\", \"Salted Caramel Velvet\", \"Pistachio & Saffron\"],\n    sizes: [\"0.5 Kg\", \"1 Kg\", \"1.5_Kg\", \"2+ Kg\"]\n  },\n  {\n    id: \"cake-2\",\n    name: \"Salted Caramel Espresso Gateau\",\n    description: \"Decadent dark chocolate layers soaked in a gentle house-blend espresso syrup, dressed with a dense espresso-infused dark chocolate frosting and a drizzle of hand-boiled sea-salt caramel.\",\n    priceEstimate: \"\342\202\2711,500 / Kg\",\n    category: \"cakes\",\n    image: \"https://images.unsplash.com/photo-1578985545062-69928b1d9587?q=80&w=800&auto=format&fit=crop\",\n    rating: 5.0,\n    tags: [\"Rich\", \"Coffee lovers\", \"Customizable\"],\n    customizable: true,\n    flavors: [\"Dark Cocoa Espresso\", \"Classic Double Chocolate\", \"Caramel Gold Crunch\"],\n    sizes: [\"0.5 Kg\", \"1 Kg\", \"2 Kg\"]\n  },\n  {\n    id: \"cake-3\",\n    name: \"Golden Honey & Lavender Drip\",\n    description: \"Light, lavender-scented sponge cake bound by cream cheese frosting whipped with raw forest honey. Beautifully decorated with gold gold-leaf flakes and dried lavender sprigs.\",\n    priceEstimate: \"\342\202\2711,600 / Kg\",\n    category: \"cakes\",\n    image: \"https://images.unsplash.com/photo-1542826438-bd32f43d626f?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.8,\n    tags: [\"Floral Elegant\", \"Chef\'s Special\"],\n    customizable: true,\n    flavors: [\"Wildflower Lavender Honey\", \"Lemon Zest Lavender\", \"Spiced Saffron\"],\n    sizes: [\"1 Kg\", \"1.5_Kg\", \"2 Kg\"]\n  },\n  \n  // BROWNIES\n  {\n    id: \"brownie-1\",\n    name: \"Maldon Sea Salt Fudgy Brownies\",\n    description: \"Crafted with 70% dark Belgian chocolate couverture, baked to achieve a super-dense fudgy interior and a perfect micro-crinkle top. Finished with a light sprinkle of flaky Maldon sea salt.\",\n    priceEstimate: \"\342\202\271550 / Pack of 4\",\n    category: \"brownies\",\n    image: \"https://images.unsplash.com/photo-1606313564200-e75d5e30476c?q=80&w=800&auto=format&fit=crop\",\n    rating: 5.0,\n    tags: [\"Legendary\", \"Intense Dark Chocolate\", \"Eggless Option\"],\n    customizable: false\n  },\n  {\n    id: \"brownie-2\",\n    name: \"Caramel Walnut Fudge Slab\",\n    description: \"Our signature Belgian brownie base loaded with crispy, hand-roasted premium walnuts and rich swirls of house-cooked butterscotch caramel drizzle.\",\n    priceEstimate: \"\342\202\271650 / Pack of 4\",\n    category: \"brownies\",\n    image: \"https://images.unsplash.com/photo-1564355808539-22fda35bed7e?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.9,\n    tags: [\"Nutty Crunch\", \"Caramel Warmth\"],\n    customizable: false\n  },\n  \n  // CHEESECAKES\n  {\n    id: \"cheesecake-1\",\n    name: \"Burnt Basque Caramel Custard\",\n    description: \"Baked crustless at high heat to achieve a deeply caramelized and charred mahogany crown, while maintaining a smooth, silky, almost-molten cream cheese core.\",\n    priceEstimate: \"\342\202\2711,800 / Whole (Approx. 1 Kg)\",\n    category: \"cheesecakes\",\n    image: \"https://images.unsplash.com/photo-1533134242443-d4fd215305ad?q=80&w=800&auto=format&fit=crop\",\n    rating: 5.0,\n    tags: [\"Decadent\", \"Crustless\", \"Gourmet favorite\"],\n    customizable: true,\n    flavors: [\"Classic Basque Cream\", \"Chocolate Marble Basque\", \"Salted Biscoff Basque\"],\n    sizes: [\"1 Kg Whole\"]\n  },\n  {\n    id: \"cheesecake-2\",\n    name: \"New York Berry Jubilee\",\n    description: \"Rich and ultra-dense cream cheese cake slow-baked over a crisp graham cracker crust, finished with a fresh hand-crushed raspberry and local blueberry compote topping.\",\n    priceEstimate: \"\342\202\2711,700 / Whole (Approx. 1 Kg)\",\n    category: \"cheesecakes\",\n    image: \"https://images.unsplash.com/photo-1524351199679-46cddf530c04?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.8,\n    tags: [\"Timeless\", \"Bright Fruity\"],\n    customizable: false\n  },\n\n  // COOKIES\n  {\n    id: \"cookie-1\",\n    name: \"Dark Chocolate Hazelnut Chunkers\",\n    description: \"Oversized, warm-centered, chewy butter cookies packed with hand-chopped 54% dark Belgian chocolate blocks and freshly toasted organic hazelnuts.\",\n    priceEstimate: \"\342\202\271380 / Pack of 3\",\n    category: \"cookies\",\n    image: \"https://images.unsplash.com/photo-1499636136210-6f4ee915583e?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.9,\n    tags: [\"Warm Chewy\", \"Comfort Biscuit\"],\n    customizable: false\n  },\n  {\n    id: \"cookie-2\",\n    name: \"Pistachio & Cranberry Shortbreads\",\n    description: \"Rich, melt-in-your-mouth pure butter shortbread cookies studded with vibrant green Persian pistachios and tart ruby cranberries.\",\n    priceEstimate: \"\342\202\271420 / Pack of 3\",\n    category: \"cookies\",\n    image: \"https://images.unsplash.com/photo-1558961309-dbdf0f62ff44?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.7,\n    tags: [\"Melt-in-mouth\", \"Festive Pack\"],\n    customizable: false\n  },\n\n  // CUPCAKES\n  {\n    id: \"cupcake-1\",\n    name: \"Lavender Honey Velvet Cakes\",\n    description: \"Delicate, light vanilla & lavender infused flour muffins frosted with a dense, silky crown of whipped wildflower honey cream cheese.\",\n    priceEstimate: \"\342\202\271480 / Box of 4\",\n    category: \"cupcakes\",\n    image: \"https://images.unsplash.com/photo-1587314168485-3236d6710814?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.9,\n    tags: [\"Delicate Artistry\", \"Great Gift\"],\n    customizable: false\n  },\n\n  // SAVORY BAKES\n  {\n    id: \"savory-1\",\n    name: \"Caramelized Onion & Gruy\303\250re Tart\",\n    description: \"A flaky, deeply buttery French-style pastry crust filled with slow-caramelized sweet golden onions, balsamic touches, and a luxurious top layer of melted imported Gruy\303\250re cheese.\",\n    priceEstimate: \"\342\202\271650 / 8-inch Tart\",\n    category: \"savory\",\n    image: \"https://images.unsplash.com/photo-1608039829572-78524f79c4c7?q=80&w=800&auto=format&fit=crop\",\n    rating: 5.0,\n    tags: [\"Umami\", \"Rich & Flaky\", \"Savory Classic\"],\n    customizable: false\n  },\n  {\n    id: \"savory-2\",\n    name: \"Wild Rosemary Garlic Pull-Apart Bread\",\n    description: \"Intensely soft, slow-fermented organic sourdough pull-apart buns infused with deep-roasted garlic cloves, garden fresh rosemary, and coated generously with extra virgin cold-pressed olive oil.\",\n    priceEstimate: \"\342\202\271350 / Loaf\",\n    category: \"savory\",\n    image: \"https://images.unsplash.com/photo-1509440159596-0249088772ff?q=80&w=800&auto=format&fit=crop\",\n    rating: 4.9,\n    tags: [\"Sourdough Base\", \"Arriving Warm\"],\n    customizable: false\n  }\n];\n\nexport const TESTIMONIALS: Testimonial[] = [\n  {\n    id: \"t-1\",\n    name: \"Aparna K.\",\n    role: \"Birthday Celebration Customized Cake Client\",\n    text: \"Belaku Bakes crafted a gorgeous 2-tier lavender honey bespoke cake for my mother\'s milestone birthday. Not only was it an absolute work of modern botanical art, but the taste was exceptionally balanced\342\200\224rich and moist without being overwhelming or overly sweet. Truly Bangalore\'s best cloud kitchen gem!\",\n    rating: 5\n  },\n  {\n    id: \"t-2\",\n    name: \"Vikram Sen\",\n    role: \"Regular Brownie & Savory Lover\",\n    text: \"The Maldon Sea Salt Fudgy Brownies are an out-of-this-world experience. You can taste the purity and quality of the chocolate. They arrive packaged beautifully. I arrange a pickup through Dunzo every second Friday. It\'s my absolute comfort food.\",\n    rating: 5\n  },\n  {\n    id: \"t-3\",\n    name: \"Sarah Andrews\",\n    role: \"Sunday Brunch Enthusiast\",\n    text: \"The Caramelized Onion & Gruy\303\250re Tart is incredible! It\'s so flaky and buttery. Belaku Bakes proves that savory cloud kitchen bakes can look and taste like absolute 5-star bakery items. The owner is so responsive and kind when ordering.\",\n    rating: 5\n  }\n];\n\nexport const STORE_CHEF_STATEMENT = {\n  brandName: \"Belaku Bakes\",\n  philosophy: \"We believe good food creates happy, eternal memories. Each dessert must carry a spark of light and delight.\",\n  fullQuote: `Belaku Bakes, a cloud kitchen created from my passion for baking and bringing joy through desserts.\nAt Belaku Bakes, I craft a wide variety of sweet treats, including brownies, cookies, cheesecakes, cupcakes, customized cakes, and savory bakes. Every item is made with care, attention to detail, and a genuine love for creating something special.\n\nFor me, baking is more than just a profession\342\200\224it\'s what makes me happy. The greatest reward is seeing my customers and clients enjoy what I create. Knowing that my desserts can be a part of someone\'s celebration, special moment, or simple craving brings me immense satisfaction and motivates me to keep baking with passion every day.\n\nBelaku Bakes was built on the belief that good food creates happy memories. Whether it\'s a customized cake for a milestone event or a box of brownies to brighten someone\'s day, my goal is to make every order memorable and bring a smile to every customer\'s face.`\n};\n\nexport const CONTACT_INFO = {\n  whatsappNumber: \"+919876543210\", // Realist number schema for Indian phone layout\n  formattedPhone: \"+91 98765 43210\",\n  address: \"Belaku Bakes, 14th Cross Road, 4th Block, Koramangala (Near Maharaja Signal), Bengaluru, Karnataka 560034\",\n  mapCoordinateGoogleMaps: \"https://www.google.com/maps/search/?api=1&query=Maharaja+Signal+Koramangala+Bangalore\",\n  operatingHours: \"10:30 AM - 8:30 PM (Tuesday to Sunday, Closed Mondays)\",\n  deliveryNote: \"We operate as an artisanal kitchen and do not run our own delivery fleet. Pickups can be easily coordinated via local delivery apps (Dunzo, Porter, Swiggy Genie, or Uber) or picked up by hand.\"\n};\n"
    }
