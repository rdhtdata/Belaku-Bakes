        lines {
          text: "export const TESTIMONIALS: Testimonial[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \"t-1\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \"Apoorva Nair\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"Milestone Anniversary Custom Cake Client\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"I ordered a custom Chocolate Hazelnut cake for my parents\' anniversary! Vaishnavi was so understanding and meticulous. The buttercream was perfectly sweet, and the crumb was unbelievably light and moist. Everybody loved it! Truly the best cloud kitchen in Hennur, Bangalore.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    rating: 5"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \"t-2\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \"Karthik Subramanian\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"Regular Brownie Box Switter\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"The Biscoff-swirled brownie bites are magical. Absolutely fudgy, with a gorgeous crinkle shell. Since they are a cloud kitchen, I simply schedule a Swiggy Genie pickup from Hennur, and it arrives packed beautifully in elegant beige boxes. Quality of chocolate is premium!\","
