          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "export const STORE_CHEF_STATEMENT = {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  brandName: \"Belaku Bakes\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  philosophy: \"We believe good food creates happy, eternal memories. Each dessert must carry a spark of light and delight.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  founderName: \"Vaishnavi K.S.\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  fullQuote: `Belaku Bakes, a cloud kitchen created from my passion for baking and bringing joy through desserts."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "At Belaku Bakes, I craft a wide variety of sweet treats, including brownies, cookies, cheesecakes, cupcakes, customized cakes, and savory bakes. Every item is made with care, attention to detail, and a genuine love for creating something special."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "For me, baking is more than just a profession\342\200\224it\'s what makes me happy. The greatest reward is seeing my customers and clients enjoy what I create. Knowing that my desserts can be a part of someone\'s celebration, special moment, or simple craving brings me immense satisfaction and motivates me to keep baking with passion every day."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "Belaku Bakes was built on the belief that good food creates happy memories. Whether it\'s a customized cake for a milestone event or a box of brownies to brighten someone\'s day, my goal is to make every order memorable and bring a smile to every customer\'s face.`"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
