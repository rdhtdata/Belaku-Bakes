        }
        lines {
          text: "    name: \"Vikram Sen\","
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    role: \"Regular Brownie & Savory Lover\","
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    text: \"The Maldon Sea Salt Fudgy Brownies are an out-of-this-world experience. You can taste the purity and quality of the chocolate. They arrive packaged beautifully. I arrange a pickup through Dunzo every second Friday. It\'s my absolute comfort food.\","
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    name: \"Karthik Subramanian\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    role: \"Regular Brownie Box Switter\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    text: \"The Biscoff-swirled brownie bites are magical. Absolutely fudgy, with a gorgeous crinkle shell. Since they are a cloud kitchen, I simply schedule a Swiggy Genie pickup from Hennur, and it arrives packed beautifully in elegant beige boxes. Quality of chocolate is premium!\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
