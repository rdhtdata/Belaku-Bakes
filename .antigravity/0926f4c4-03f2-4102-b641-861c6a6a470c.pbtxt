          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"The Biscoff-swirled brownie bites are magical. Absolutely fudgy, with a gorgeous crinkle shell. Since they are a cloud kitchen, I simply schedule a Swiggy Genie pickup from Hennur, and it arrives packed beautifully in elegant beige boxes. Quality of chocolate is premium!\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    rating: 5"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    id: \"t-3\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    name: \"Meera Sen\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    role: \"Sunday Savouries Lover\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    text: \"We ordered the Garlic Bread and Korean Buns alongside the Strawberry Cheesecake 500g for a cozy family dinner gathering. Not only was the bread incredibly soft and fragrant with actual fresh rosemary, but the cheesecake was outstandingly dense. Clean ingredients make all the difference!\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    rating: 5"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
