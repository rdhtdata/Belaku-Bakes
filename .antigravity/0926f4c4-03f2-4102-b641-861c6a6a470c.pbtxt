          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    name: \"Vikram Sen\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    role: \"Regular Brownie & Savory Lover\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    text: \"The Maldon Sea Salt Fudgy Brownies are an out-of-this-world experience. You can taste the purity and quality of the chocolate. They arrive packaged beautifully. I arrange a pickup through Dunzo every second Friday. It\'s my absolute comfort food.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    rating: 5"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
